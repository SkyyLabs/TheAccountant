# Copy to .env (repo root) to override defaults. Every value here is optional.
# No secrets belong in this file: bank PDF passwords live in the macOS Keychain.

# SQLite file, the only datastore. Default: <repo>/data/accountant.db
# DATABASE_PATH=/absolute/path/to/accountant.db

# Local Ollama only. Any non-loopback host is rejected at startup.
OLLAMA_URL=http://127.0.0.1:11434

# ollama | mock (mock is deterministic and used by tests)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b

PORT=8765
MAX_UPLOAD_MB=25

# Docling layout and table models, downloaded by `make models`. Default: <repo>/models/docling
# DOCLING_MODELS_PATH=/absolute/path/to/models/docling
